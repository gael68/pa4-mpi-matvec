#!/bin/bash
#SBATCH -J pa4-task4
#SBATCH -p RM-shared
#SBATCH -N 1
# 16 cores for the ~2 GB/core memory: rank 0 holds two 8 GB copies of A at n=32000
#SBATCH --tasks-per-node=16
#SBATCH -t 0:30:00
#SBATCH -o task4-%j.out

cd "$SLURM_SUBMIT_DIR"
export HOSTNAME=${HOSTNAME:-$(hostname -s)}
module load openmpi

# echo commands to stdout (after module load, whose trace is hundreds of lines)
set -x
make mvm

RUNS=5
for np in 1 2 4 8; do
    for r in $(seq 1 $RUNS); do
        echo "Running with $np processes (run $r)..."
        mpirun -n $np ./mvm 32000
    done
done

echo "Job completed"
